<shell>
taf_nextclade_safe_path() {
    test -n "$1" &&
        test "$(printf '%s' "$1" | tr -d ' \011\012\013\014\015\052\054\072\077\133\135')" = "$1"
}

taf_nextclade_complete_root() {
    taf_nextclade_root="$1"
    test -d "$taf_nextclade_root" || return 1
    test -s "$taf_nextclade_root/TAFFISH_DATASET_MANIFEST.json" || return 1
    test -s "$taf_nextclade_root/TAFFISH_DATASET_INVENTORY.tsv" || return 1
    test -s "$taf_nextclade_root/TAFFISH_DATASET_READY" || return 1
    grep -F 'taffish.nextclade.dataset-root.v1' "$taf_nextclade_root/TAFFISH_DATASET_MANIFEST.json" >/dev/null || return 1
    grep -F '"app_version": "3.23.0"' "$taf_nextclade_root/TAFFISH_DATASET_MANIFEST.json" >/dev/null || return 1
    taf_nextclade_count=0
    while IFS="$(printf '\t')" read -r taf_nextclade_id taf_nextclade_tag taf_nextclade_rel taf_nextclade_digest taf_nextclade_files taf_nextclade_bytes taf_nextclade_source taf_nextclade_license; do
        test "$taf_nextclade_id" = dataset_id && continue
        case "$taf_nextclade_id" in ''|/*|*/|*//*|.|..|./*|../*|*/.|*/..|*/./*|*/../*|*[!A-Za-z0-9._+/-]*) return 1 ;; esac
        case "$taf_nextclade_tag" in ''|.|..|*[!A-Za-z0-9._:+-]*) return 1 ;; esac
        test "$taf_nextclade_rel" = "members/$taf_nextclade_id/$taf_nextclade_tag" || return 1
        test -s "$taf_nextclade_root/$taf_nextclade_rel/TAFFISH_DATASET_MEMBER.json" || return 1
        test -s "$taf_nextclade_root/$taf_nextclade_rel/TAFFISH_DATASET_MEMBER_INVENTORY.sha256" || return 1
        test -s "$taf_nextclade_root/$taf_nextclade_rel/TAFFISH_DATASET_MEMBER_READY" || return 1
        taf_nextclade_count=$((taf_nextclade_count + 1))
    done < "$taf_nextclade_root/TAFFISH_DATASET_INVENTORY.tsv"
    test "$taf_nextclade_count" -gt 0
}

taf_nextclade_install="${TAFFISH_NEXTCLADE_DATASET_INSTALL_ROOT:-}"
if test -n "$taf_nextclade_install"; then
    if ! test -d "$taf_nextclade_install" || ! test -w "$taf_nextclade_install"; then
        printf >&2 'taf-nextclade: TAFFISH_NEXTCLADE_DATASET_INSTALL_ROOT must be an existing writable directory: %s\n' "$taf_nextclade_install"
        exit 64
    fi
    taf_nextclade_install="$(CDPATH= cd "$taf_nextclade_install" 2>/dev/null && pwd -P)"
    if ! taf_nextclade_safe_path "$taf_nextclade_install"; then
        printf >&2 'taf-nextclade: dataset install path contains unsupported whitespace, comma, colon, or glob characters: %s\n' "$taf_nextclade_install"
        exit 64
    fi
fi

taf_nextclade_data=
taf_nextclade_auto="${TAFFISH_NEXTCLADE_DATASET_AUTO_MOUNT:-1}"
case "$taf_nextclade_auto" in
    0|false|FALSE|no|NO|off|OFF) taf_nextclade_auto=0 ;;
    1|true|TRUE|yes|YES|on|ON) taf_nextclade_auto=1 ;;
    *)
        printf >&2 'taf-nextclade: TAFFISH_NEXTCLADE_DATASET_AUTO_MOUNT must be 0/1 or a documented boolean value\n'
        exit 64
        ;;
esac

if test -z "$taf_nextclade_install" && test "$taf_nextclade_auto" = 1; then
    taf_nextclade_explicit=0
    if test "${TAFFISH_NEXTCLADE_DATASET_PATH+x}" = x; then
        taf_nextclade_explicit=1
        taf_nextclade_data="${TAFFISH_NEXTCLADE_DATASET_PATH:-}"
    else
        taf_nextclade_user_base="${XDG_DATA_HOME:-${HOME:-}/.local/share}"
        for taf_nextclade_candidate in \
            "$taf_nextclade_user_base/taffish/datasets/nextclade/3.23.0" \
            "/usr/local/share/taffish/datasets/nextclade/3.23.0" \
            "/opt/taffish/datasets/nextclade/3.23.0"; do
            if test -e "$taf_nextclade_candidate"; then
                taf_nextclade_data="$taf_nextclade_candidate"
                break
            fi
        done
    fi
    if test -n "$taf_nextclade_data"; then
        if ! taf_nextclade_complete_root "$taf_nextclade_data"; then
            printf >&2 'taf-nextclade: selected dataset root is incomplete or invalid: %s\n' "$taf_nextclade_data"
            printf >&2 'taf-nextclade: repair it with nextclade-datasets, select another TAFFISH_NEXTCLADE_DATASET_PATH, or set TAFFISH_NEXTCLADE_DATASET_AUTO_MOUNT=0\n'
            exit 64
        fi
        taf_nextclade_data="$(CDPATH= cd "$taf_nextclade_data" 2>/dev/null && pwd -P)"
        if ! taf_nextclade_safe_path "$taf_nextclade_data"; then
            printf >&2 'taf-nextclade: dataset path contains unsupported whitespace, comma, colon, or glob characters: %s\n' "$taf_nextclade_data"
            exit 64
        fi
    elif test "$taf_nextclade_explicit" = 1; then
        printf >&2 'taf-nextclade: TAFFISH_NEXTCLADE_DATASET_PATH is empty or does not name a prepared root\n'
        exit 64
    fi
fi

export APPTAINERENV_TAFFISH_NEXTCLADE_WEB_LOG_FILE="${TAFFISH_NEXTCLADE_WEB_LOG_FILE:-}"

<taf-app:container:ghcr.io/taffish/nextclade:3.23.0-r2$@[docker/podman: --init --env=TAFFISH_NEXTCLADE_WEB_LOG_FILE][docker: --user=$(id -u):$(id -g)][podman: --userns=keep-id --user=$(id -u):$(id -g)][docker/podman: $(if test -n "${taf_nextclade_install:-}"; then printf -- '--volume=%s:/dataset-install --env=TAFFISH_NEXTCLADE_DATASET_INSTALL_MOUNTED=1' "$taf_nextclade_install"; fi) $(if test -n "${taf_nextclade_data:-}"; then printf -- '--volume=%s:/opt/taffish/datasets/nextclade:ro --env=TAFFISH_NEXTCLADE_DATASET_MOUNTED=1' "$taf_nextclade_data"; fi)][apptainer: $(if test -n "${taf_nextclade_install:-}"; then printf -- '--bind=%s:/dataset-install --env=TAFFISH_NEXTCLADE_DATASET_INSTALL_MOUNTED=1' "$taf_nextclade_install"; fi) $(if test -n "${taf_nextclade_data:-}"; then printf -- '--bind=%s:/opt/taffish/datasets/nextclade:ro --env=TAFFISH_NEXTCLADE_DATASET_MOUNTED=1' "$taf_nextclade_data"; fi)]>
nextclade ::*ARGV*::
