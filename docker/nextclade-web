#!/bin/sh
set -eu

port=8000
host_port=
url_host=127.0.0.1
startup_timeout=30
log_file="${TAFFISH_NEXTCLADE_WEB_LOG_FILE:-}"
log_file_explicit=0
if [ -n "$log_file" ]; then
  log_file_explicit=1
fi

if [ -n "${APPTAINER_CONTAINER:-}${SINGULARITY_CONTAINER:-}" ]; then
  bind_address=127.0.0.1
  shared_host_network=1
else
  bind_address=0.0.0.0
  shared_host_network=0
fi

usage() {
  cat <<'EOF'
Start the packaged Nextclade Web client as a foreground browser service.

Usage:
  nextclade-web [options]

Options:
  -p, --port PORT         Container/service port, default 8000
  --host-port PORT        Host port printed in the URL, default same as --port
  --url-host HOST         Host name printed in the URL, default 127.0.0.1
  --bind-address ADDRESS  Bind to 0.0.0.0 or 127.0.0.1 (backend-aware default)
  --startup-timeout N     Readiness timeout in seconds, default 30
  --log-file FILE         Preserve the internal HTTP log at FILE; by default
                          use TAFFISH_NEXTCLADE_WEB_LOG_FILE when nonempty,
                          otherwise the unique runtime directory
  --version               Show the packaged Web version and upstream commit
  -h, --help              Show this help

Docker and Podman need an explicit host port mapping. Apptainer normally
shares the host network and defaults to a loopback-only bind. The service has
no built-in authentication or TLS; prefer a loopback mapping or SSH tunnel.
For whitespace paths through the TAFFISH wrapper, set the log environment
variable before invoking the wrapper. An explicit --log-file takes precedence.
EOF
}

need_value() {
  if [ "$#" -lt 2 ]; then
    echo "nextclade-web: missing value for $1" >&2
    exit 2
  fi
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -p|--port)
      need_value "$@"
      port="$2"
      shift 2
      ;;
    --port=*) port="${1#*=}"; shift ;;
    --host-port)
      need_value "$@"
      host_port="$2"
      shift 2
      ;;
    --host-port=*) host_port="${1#*=}"; shift ;;
    --url-host)
      need_value "$@"
      url_host="$2"
      shift 2
      ;;
    --url-host=*) url_host="${1#*=}"; shift ;;
    --bind-address)
      need_value "$@"
      bind_address="$2"
      shift 2
      ;;
    --bind-address=*) bind_address="${1#*=}"; shift ;;
    --startup-timeout)
      need_value "$@"
      startup_timeout="$2"
      shift 2
      ;;
    --startup-timeout=*) startup_timeout="${1#*=}"; shift ;;
    --log-file)
      need_value "$@"
      log_file="$2"
      log_file_explicit=1
      shift 2
      ;;
    --log-file=*) log_file="${1#*=}"; log_file_explicit=1; shift ;;
    --version)
      echo "Nextclade Web 3.23.0"
      echo "upstream commit 629ea8fb0cfe3165db13ddc75dab16d3c2292dbd"
      exit 0
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "nextclade-web: unknown option: $1" >&2
      echo "Run 'nextclade-web --help' for usage." >&2
      exit 2
      ;;
  esac
done

require_positive_integer() {
  value="$1"
  option_name="$2"
  case "$value" in
    ''|*[!0-9]*)
      echo "nextclade-web: $option_name must be a positive integer" >&2
      exit 2
      ;;
  esac
  if [ "$value" -lt 1 ]; then
    echo "nextclade-web: $option_name must be a positive integer" >&2
    exit 2
  fi
}

require_positive_integer "$port" "--port"
require_positive_integer "$startup_timeout" "--startup-timeout"
if [ "$port" -gt 65535 ]; then
  echo "nextclade-web: --port must be at most 65535" >&2
  exit 2
fi
if [ -z "$host_port" ]; then
  host_port="$port"
fi
require_positive_integer "$host_port" "--host-port"
if [ "$host_port" -gt 65535 ]; then
  echo "nextclade-web: --host-port must be at most 65535" >&2
  exit 2
fi
case "$bind_address" in
  0.0.0.0|127.0.0.1) ;;
  *)
    echo "nextclade-web: --bind-address must be 0.0.0.0 or 127.0.0.1" >&2
    exit 2
    ;;
esac
case "$url_host" in
  ''|*[!A-Za-z0-9._:-]*)
    echo "nextclade-web: --url-host contains unsupported characters" >&2
    exit 2
    ;;
esac
if [ "$log_file_explicit" -eq 1 ] && [ -z "$log_file" ]; then
  echo "nextclade-web: --log-file must not be empty" >&2
  exit 2
fi

runtime_dir="$(mktemp -d /tmp/nextclade-web.XXXXXX)"
if [ "$log_file_explicit" -eq 0 ]; then
  log_file="${runtime_dir}/http.log"
fi
nginx_config="${runtime_dir}/nginx.conf"
service_pid=
service_pgid=
service_group_owned=0
service_launcher_pid=
service_status_file="${runtime_dir}/nginx.status"
delay_pid=

positive_pid() {
  case "${1:-}" in
    ''|*[!0-9]*|0|1) return 1 ;;
  esac
  return 0
}

owned_group_alive() {
  [ "$service_group_owned" -eq 1 ] || return 1
  positive_pid "$service_pgid" || return 1
  [ "$service_pid" = "$service_pgid" ] || return 1
  kill -0 "-$service_pgid" 2>/dev/null
}

stop_delay() {
  if positive_pid "$delay_pid" && kill -0 "$delay_pid" 2>/dev/null; then
    kill -TERM "$delay_pid" 2>/dev/null || true
    wait "$delay_pid" >/dev/null 2>&1 || true
  fi
  delay_pid=
}

stop_service() {
  if owned_group_alive; then
    kill -TERM "-$service_pgid" 2>/dev/null || true
    count=0
    while owned_group_alive && [ "$count" -lt 50 ]; do
      count=$((count + 1))
      sleep 0.1
    done
    if owned_group_alive; then
      kill -KILL "-$service_pgid" 2>/dev/null || true
    fi
  elif positive_pid "$service_pid" && kill -0 "$service_pid" 2>/dev/null; then
    kill -TERM "$service_pid" 2>/dev/null || true
  fi
  if positive_pid "$service_pid"; then
    wait "$service_pid" >/dev/null 2>&1 || true
  fi
  if positive_pid "$service_launcher_pid"; then
    wait "$service_launcher_pid" >/dev/null 2>&1 || true
  fi
  service_pid=
  service_pgid=
  service_group_owned=0
  service_launcher_pid=
}

cleanup() {
  stop_delay
  stop_service
  rm -rf "$runtime_dir"
}

on_int() {
  trap '' INT TERM HUP
  trap - EXIT
  echo
  echo "Nextclade Web is stopping after Ctrl-C."
  cleanup
  echo "Nextclade Web stopped."
  exit 130
}

on_term() {
  trap '' INT TERM HUP
  trap - EXIT
  echo
  echo "Nextclade Web is stopping after TERM."
  cleanup
  echo "Nextclade Web stopped."
  exit 143
}

trap on_int INT
trap on_term TERM
trap cleanup EXIT

mkdir -p "$(dirname "$log_file")"
: > "$log_file"

cat <<EOF
Nextclade Web is starting.
EOF
if [ "$shared_host_network" -eq 1 ]; then
  cat <<EOF

This backend shares the host network. Open this URL directly:
  http://${url_host}:${host_port}/
EOF
else
  cat <<EOF

Open this URL after mapping the container port to the host:
  http://${url_host}:${host_port}/
EOF
fi
cat <<EOF

If this is running on a remote server over SSH, tunnel the host port first:
  ssh -N -L ${host_port}:127.0.0.1:${host_port} user@server

Then open the same URL in your local browser.

Press Ctrl-C to stop this Nextclade Web session.
Internal HTTP log:
  ${log_file}
EOF

test_delay="${NEXTCLADE_WEB_TEST_STARTUP_DELAY:-0}"
case "$test_delay" in
  ''|*[!0-9]*)
    echo "nextclade-web: NEXTCLADE_WEB_TEST_STARTUP_DELAY must be a nonnegative integer" >&2
    exit 2
    ;;
esac
critical_test="${NEXTCLADE_WEB_TEST_CRITICAL_EXIT_AFTER_READY:-0}"
case "$critical_test" in
  0|1|zero) ;;
  *)
    echo "nextclade-web: NEXTCLADE_WEB_TEST_CRITICAL_EXIT_AFTER_READY must be 0, 1, or zero" >&2
    exit 2
    ;;
esac
if [ "$test_delay" -gt 0 ]; then
  sleep "$test_delay" &
  delay_pid="$!"
  wait "$delay_pid"
  delay_pid=
fi

mkdir -p \
  "$runtime_dir/client_body" \
  "$runtime_dir/proxy" \
  "$runtime_dir/fastcgi" \
  "$runtime_dir/uwsgi" \
  "$runtime_dir/scgi"

cat > "$nginx_config" <<EOF
pid ${runtime_dir}/nginx.pid;
error_log /dev/stderr info;
worker_processes 1;
worker_shutdown_timeout 5s;

events {
  worker_connections 128;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  log_format main '\$remote_addr - \$request \$status \$body_bytes_sent';
  access_log /dev/stdout main;
  sendfile on;
  client_body_temp_path ${runtime_dir}/client_body;
  proxy_temp_path ${runtime_dir}/proxy;
  fastcgi_temp_path ${runtime_dir}/fastcgi;
  uwsgi_temp_path ${runtime_dir}/uwsgi;
  scgi_temp_path ${runtime_dir}/scgi;

  server {
    listen ${bind_address}:${port};
    server_name _;
    root /usr/share/nextclade-web;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    location = /_taf_health {
      access_log off;
      default_type text/plain;
      return 200 'nextclade-web\n';
    }

    location / {
      try_files \$uri \$uri.html \$uri/ /index.html;
    }
  }
}
EOF

service_pid_file="${runtime_dir}/service.pid"
setsid sh -c '
  pid_file=$1
  status_file=$2
  shift 2
  printf "%s\n" "$$" > "$pid_file"
  set +e
  "$@"
  status=$?
  set -e
  printf "%s\n" "$status" > "$status_file"
  exit "$status"
' sh "$service_pid_file" "$service_status_file" \
  nginx -e stderr -c "$nginx_config" -g 'daemon off;' >"$log_file" 2>&1 &
service_launcher_pid="$!"
count=0
while [ ! -s "$service_pid_file" ] && [ "$count" -lt 40 ]; do
  count=$((count + 1))
  sleep 0.05
done
service_pid=$(sed -n '1p' "$service_pid_file" 2>/dev/null || true)
service_pgid="$service_pid"
if ! positive_pid "$service_pid"; then
  echo "nextclade-web: service supervisor returned an invalid process id" >&2
  stop_service
  exit 1
fi
count=0
while [ ! -r "/proc/$service_pid/stat" ] && [ "$count" -lt 20 ]; do
  count=$((count + 1))
  sleep 0.05
done
actual_pgid=$(awk '{print $5}' "/proc/$service_pid/stat" 2>/dev/null || true)
if [ "$actual_pgid" != "$service_pid" ]; then
  echo "nextclade-web: service supervisor did not enter its owned process group" >&2
  stop_service
  tail -n 40 "$log_file" >&2 || true
  exit 1
fi
service_group_owned=1

probe_url="http://127.0.0.1:${port}/_taf_health"
elapsed=0
while [ "$elapsed" -lt "$startup_timeout" ]; do
  if [ -s "$service_status_file" ] || ! owned_group_alive; then
    service_status=$(sed -n '1p' "$service_status_file" 2>/dev/null || true)
    case "$service_status" in ''|*[!0-9]*) service_status=1 ;; esac
    stop_service
    echo "nextclade-web: service exited during startup with status ${service_status}" >&2
    tail -n 40 "$log_file" >&2 || true
    exit 1
  fi
  if response="$(wget -qO- -T 1 "$probe_url" 2>/dev/null)" && \
     [ "$response" = "nextclade-web" ] && owned_group_alive; then
    echo
    echo "Nextclade Web is ready."
    case "$critical_test" in
      1|zero)
        nginx_pid=$(sed -n '1p' "${runtime_dir}/nginx.pid" 2>/dev/null || true)
        if positive_pid "$nginx_pid" && kill -0 "$nginx_pid" 2>/dev/null; then
          if [ "$critical_test" = 1 ]; then
            kill -KILL "$nginx_pid" 2>/dev/null || true
          else
            kill -QUIT "$nginx_pid" 2>/dev/null || true
          fi
        else
          echo "nextclade-web: could not identify the nginx master for failure injection" >&2
          exit 1
        fi
        ;;
    esac
    while [ ! -s "$service_status_file" ] && owned_group_alive; do
      sleep 0.2
    done
    service_status=$(sed -n '1p' "$service_status_file" 2>/dev/null || true)
    case "$service_status" in ''|*[!0-9]*) service_status=1 ;; esac
    stop_service
    echo "nextclade-web: critical process nginx exited with status ${service_status}" >&2
    tail -n 40 "$log_file" >&2 || true
    helper_status="$service_status"
    if [ "$helper_status" -eq 0 ]; then
      helper_status=1
    fi
    trap - EXIT
    rm -rf "$runtime_dir"
    exit "$helper_status"
  fi
  elapsed=$((elapsed + 1))
  sleep 1
done

echo "nextclade-web: timed out waiting for ${probe_url}" >&2
tail -n 40 "$log_file" >&2 || true
exit 1
